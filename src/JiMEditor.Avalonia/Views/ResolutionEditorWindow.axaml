<!-- Ported from: JiMEditor TextEditorWindow (EditMode.Resolution) / ScenarioWindow resolution actions (2026-04-21). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:jime="using:JiME"
        xmlns:v="using:JiMEditor.Avalonia.Views"
        x:Class="JiMEditor.Avalonia.Views.ResolutionEditorWindow"
        x:CompileBindings="False"
        Title="Resolution Editor"
        Width="720"
        Height="700"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource bgColor}">

	<Window.Styles>
		<Style Selector="TextBox.campaignField">
			<Setter Property="Background" Value="#333337"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="#77777d"/>
			<Setter Property="Padding" Value="6,4"/>
		</Style>
		<Style Selector="ComboBox">
			<Setter Property="Background" Value="#333337"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<Style Selector="RadioButton">
			<Setter Property="Foreground" Value="White"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="*,Auto">
		<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="10" Spacing="10">
				<Border Classes="callout">
					<StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
						<TextBlock Classes="heading"
						           Text="Resolution Name:"
						           VerticalAlignment="Center"/>
						<TextBox x:Name="ShortNameTextBox"
						         Classes="campaignField"
						         Width="300"
						         VerticalAlignment="Center"/>
					</StackPanel>
				</Border>

				<Border Classes="callout">
					<StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
						<TextBlock Classes="heading"
						           Text="Triggered By (Required):"
						           VerticalAlignment="Center"/>
						<ComboBox x:Name="TriggerComboBox"
						          MinWidth="220"
						          Width="300"
						          VerticalAlignment="Center">
							<ComboBox.ItemTemplate>
								<DataTemplate DataType="jime:Trigger">
									<TextBlock Text="{Binding dataName}" Foreground="White"/>
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
						<Button Background="#3CB371"
						        Width="32"
						        Height="32"
						        Padding="4"
						        Margin="4,0,0,0"
						        VerticalAlignment="Center"
						        Click="AddTriggerButton_Click">
							<Image Source="avares://JiMEditor.Avalonia/Assets/add2.png" Stretch="Uniform"/>
						</Button>
					</StackPanel>
				</Border>

				<Border Classes="callout">
					<StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
						<TextBlock Classes="heading"
						           Text="This Resolution Ends the Scenario in a..."
						           VerticalAlignment="Center"
						           TextWrapping="Wrap"/>
						<RadioButton x:Name="SuccessEndRadio"
						             Content="Success"
						             GroupName="ResolutionEnd"
						             VerticalAlignment="Center"/>
						<RadioButton x:Name="FailureEndRadio"
						             Content="Failure"
						             GroupName="ResolutionEnd"
						             VerticalAlignment="Center"/>
					</StackPanel>
				</Border>

				<Border Classes="callout">
					<StackPanel Spacing="8">
						<TextBlock Classes="heading" Text="Resolution Text:"/>
						<ScrollViewer Height="400" MaxHeight="400"
						              VerticalScrollBarVisibility="Auto"
						              HorizontalScrollBarVisibility="Disabled">
							<v:PseudoHtmlRichEditor x:Name="BodyEditor"
							                        Watermark="Resolution text (pseudo-HTML)"/>
						</ScrollViewer>
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>

		<Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="Silver" Background="#FF46464A">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="10">
				<Button MinWidth="100" Height="36" Classes="projectChromeButton" Click="CancelButton_Click" Content="Cancel"/>
				<Button MinWidth="100" Height="36" Background="#3CB371" Foreground="White" Content="OK" IsDefault="True" Click="OkButton_Click"/>
			</StackPanel>
		</Border>
	</Grid>
</Window>
