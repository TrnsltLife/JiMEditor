<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:jime="using:JiME"
        xmlns:uc="using:JiMEditor.Avalonia.UserControls"
        xmlns:conv="using:JiMEditor.Avalonia.Converters"
        xmlns:flowPreview="using:JiMEditor.Avalonia.Views"
        mc:Ignorable="d"
        d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="JiMEditor.Avalonia.Views.MainWindow"
        x:CompileBindings="False"
        Background="{StaticResource bgColor}"
        Width="1200" Height="750">

	<Window.Resources>
		<conv:BoolInvertValueConverter x:Key="chapterStartInvert"/>
	</Window.Resources>
	<!--
		Original WPF GraphX region (JiMEditor/MainWindow.xaml) — TODO-Avalonia-Reenable: replace with Avalonia graph or alternate layout.
		<zoom:ZoomControl x:Name="zoomControl" Grid.Row="1" Grid.Column="1" ZoomBoxVisibility="Collapsed" Background="#FF1E1E1E">
			<local:GraphArea x:Name="graphArea" />
		</zoom:ZoomControl>
	-->

	<DockPanel LastChildFill="True">
		<!-- Toolbar -->
		<Border DockPanel.Dock="Top" Background="{StaticResource bgColorLight}" Padding="6">
			<StackPanel Orientation="Horizontal" Spacing="4">
				<Button Classes="iconbutton"
				        Height="32"
				        Padding="4,0,4,0"
				        Click="NewProjectToolbarButton_Click"
				        ToolTip.Tip="New project (return to project list). Ctrl/⌘+N">
					<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
						<Image Source="avares://JiMEditor.Avalonia/Assets/newcampaign.png" Width="24" Height="24"/>
					</StackPanel>
				</Button>
				<Button Classes="iconbutton"
				        Height="32"
				        Padding="4,0,4,0"
				        Click="OpenToolbarButton_Click"
				        ToolTip.Tip="Open a different project (project list). Ctrl/⌘+O">
					<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
						<Image Source="avares://JiMEditor.Avalonia/Assets/open.png" Width="24" Height="24"/>
					</StackPanel>
				</Button>
				<SplitButton x:Name="SaveSplitButton"
				             Classes="iconbutton"
				             Height="32"
				             Padding="4,0,4,0"
				             Click="SaveSplitButton_Click"
				             ToolTip.Tip="Save project. Ctrl/⌘+S. Save As: Ctrl/⌘+Alt+S">
					<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
						<Image Source="avares://JiMEditor.Avalonia/Assets/save.png" Width="24" Height="24"/>
					</StackPanel>
					<SplitButton.Flyout>
						<MenuFlyout Placement="BottomEdgeAlignedLeft">
							<MenuItem Header="Save" Click="SaveMenuItem_Click"/>
							<MenuItem Header="Save As…" Click="SaveAsMenuItem_Click"/>
							<MenuItem Header="Save Copy…" Click="SaveCopyMenuItem_Click"/>
						</MenuFlyout>
					</SplitButton.Flyout>
				</SplitButton>
				<Button Classes="iconbutton"
				        Height="32"
				        Padding="4,0,4,0"
				        Click="ErrorCheckToolbarButton_Click"
				        ToolTip.Tip="Error Check">
					<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
						<Image Source="avares://JiMEditor.Avalonia/Assets/ok.png" Width="24" Height="24"/>
						<TextBlock Text="Error Check" Foreground="White" FontSize="12" Margin="4,6,0,0"/>
					</StackPanel>
				</Button>
				<Rectangle Width="1" Height="24" Fill="{StaticResource bgButtonColor}" Margin="4,0"/>
				<Grid Width="200" VerticalAlignment="Center">
					<TextBlock x:Name="ScenarioNameText"
					           Text="{Binding scenarioName}"
					           Foreground="White"
					           FontWeight="Bold"
					           FontSize="15"
					           VerticalAlignment="Center"
					           TextTrimming="CharacterEllipsis"
					           PointerPressed="ScenarioNameText_PointerPressed"/>
					<TextBox x:Name="ScenarioNameEdit"
					         Width="200"
					         Classes="campaignField"
					         FontSize="15"
					         IsVisible="False"
					         KeyDown="ScenarioNameEdit_KeyDown"
					         LostFocus="ScenarioNameEdit_LostFocus"/>
				</Grid>
				<Button Classes="iconbutton" Height="32" Padding="4,0,4,0" Click="ScenarioSettingsButton_Click" ToolTip.Tip="Edit scenario settings. Alt+S">
					<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
						<Image Source="avares://JiMEditor.Avalonia/Assets/settings.png" Width="24" Height="24"/>
						<TextBlock Text="Settings" Foreground="White" FontSize="12" Margin="4,6,0,0"/>
					</StackPanel>
				</Button>
				<Button Classes="iconbutton" Height="32" Padding="4,0,4,0" Click="ThreatsToolbarButton_Click" ToolTip.Tip="Edit threat settings">
					<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
						<Image Source="avares://JiMEditor.Avalonia/Assets/threat_button.png" Width="24" Height="24"/>
						<TextBlock Text="Threat" Foreground="White" FontSize="12" Margin="4,6,0,0"/>
					</StackPanel>
				</Button>
				<Rectangle Width="1" Height="24" Fill="{StaticResource bgButtonColor}" Margin="4,0"/>
				<Button x:Name="NewTileBlockToolbarButton"
				        Classes="iconbutton"
				        Height="32"
				        Padding="4,0,4,0"
				        Click="NewTileBlockToolbarButton_Click"
				        ToolTip.Tip="Add tile block. Alt+C">
					<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
						<Image Source="avares://JiMEditor.Avalonia/Assets/addtileblock.png" Width="24" Height="24"/>
						<TextBlock Text="New Tile Block" Foreground="White" FontSize="12" Margin="4,6,0,0"/>
					</StackPanel>
				</Button>
				<Button x:Name="AddObjectiveToolbarButton"
				        Classes="iconbutton"
				        Height="32"
				        Padding="4,0,4,0"
				        Click="AddObjectiveToolbarButton_Click"
				        ToolTip.Tip="New objective. Alt+O">
					<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
						<Image Source="avares://JiMEditor.Avalonia/Assets/addobjective.png" Width="24" Height="24"/>
						<TextBlock Text="New Objective" Foreground="White" FontSize="12" Margin="4,6,0,0"/>
					</StackPanel>
				</Button>
				<Button x:Name="AddResolutionToolbarButton"
				        Classes="iconbutton"
				        Height="32"
				        Padding="4,0,4,0"
				        Click="AddResolutionToolbarButton_Click"
				        ToolTip.Tip="New resolution">
					<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
						<Image Source="avares://JiMEditor.Avalonia/Assets/addresolution.png" Width="24" Height="24"/>
						<TextBlock Text="New Resolution" Foreground="White" FontSize="12" Margin="4,6,0,0"/>
					</StackPanel>
				</Button>
				<Button x:Name="AddEventToolbarButton"
				        Classes="iconbutton"
				        Height="32"
				        Padding="4,0,4,0"
				        Click="AddEventToolbarButton_Click"
				        ToolTip.Tip="New event. Alt+E">
					<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
						<Image Source="avares://JiMEditor.Avalonia/Assets/addevent.png" Width="24" Height="24"/>
						<TextBlock Text="New Event" Foreground="White" FontSize="12" Margin="4,6,0,0"/>
					</StackPanel>
				</Button>
				<Button x:Name="AddTriggerToolbarButton"
				        Classes="iconbutton"
				        Height="32"
				        Padding="4,0,4,0"
				        Click="AddTriggerToolbarButton_Click"
				        ToolTip.Tip="New trigger. Alt+T">
					<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
						<Image Source="avares://JiMEditor.Avalonia/Assets/addtrigger.png" Width="24" Height="24"/>
						<TextBlock Text="New Trigger" Foreground="White" FontSize="12" Margin="4,6,0,0"/>
					</StackPanel>
				</Button>
			</StackPanel>
		</Border>

		<!-- Status bar (ported from JiMEditor/MainWindow.xaml bottom bar) -->
		<Border DockPanel.Dock="Bottom"
		        Background="{StaticResource bgColorLight}"
		        MinHeight="30"
		        BorderBrush="Black"
		        BorderThickness="0,1,0,0"
		        Padding="4,2">
			<UniformGrid Columns="2">
				<StackPanel Orientation="Horizontal"
				            HorizontalAlignment="Center"
				            VerticalAlignment="Center">
					<TextBlock Foreground="White" Text="App Version:  "/>
					<TextBlock x:Name="appVersion" Foreground="White"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal"
				            HorizontalAlignment="Center"
				            VerticalAlignment="Center">
					<TextBlock Foreground="White" Text="Scenario Format Version:  "/>
					<TextBlock x:Name="formatVersion" Foreground="White"/>
				</StackPanel>
			</UniformGrid>
		</Border>

		<!-- Sidebar + tile blocks + graph (each pane has a floating collapse/expand control) -->
		<Grid x:Name="EditorSplitGrid">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="280" MinWidth="0"/>
				<ColumnDefinition Width="280" MinWidth="0"/>
				<ColumnDefinition Width="*" MinWidth="200"/>
			</Grid.ColumnDefinitions>
			<!-- Left sidebar lists -->
			<Grid Grid.Column="0"
			      Background="{StaticResource bgColorLight}"
			      ClipToBounds="False">
				<Border x:Name="SidebarContentHost"
				        Background="{StaticResource bgColorLight}"
				        Padding="4,0,4,4">
					<ScrollViewer x:Name="SidebarScrollViewer">
						<StackPanel Spacing="0">
							<TextBlock x:Name="SidebarTitleHorizontal"
							           Text="Components"
							           FontWeight="Bold"
							           FontSize="14"
							           Foreground="White"
							           HorizontalAlignment="Stretch"
							           TextAlignment="Center"
							           Margin="8,4,8,10"/>
							<Rectangle Height="1"
							           Fill="White"
							           HorizontalAlignment="Stretch"
							           Margin="4,0,4,10"/>
							<StackPanel Spacing="8">
								<uc:SidebarListView x:Name="objectivesUC"
								                    Margin="5"
								                    Title="Objectives"
								                    ShowDuplicateButton="True"
								                    ShowImportButton="False"
								                    ShowExportButton="False"/>
								<uc:SidebarListView x:Name="interactionsUC"
								                    Margin="5"
								                    Title="Events"
								                    ShowDuplicateButton="True"
								                    ShowImportButton="True"
								                    ShowExportButton="True"/>
								<uc:SidebarListView x:Name="triggersUC"
								                    Margin="5"
								                    Title="Triggers"
								                    ShowDuplicateButton="True"
								                    ShowImportButton="False"
								                    ShowExportButton="False"/>
								<uc:SidebarListView x:Name="activationsUC"
								                    Margin="5"
								                    Title="Enemy Attack Groups"
								                    ShowDuplicateButton="True"
								                    ShowImportButton="True"
								                    ShowExportButton="True"/>
								<uc:SidebarListView x:Name="monsterModifiersUC"
								                    Margin="5"
								                    Title="Enemy Bonuses"
								                    ShowDuplicateButton="True"
								                    ShowImportButton="True"
								                    ShowExportButton="True"/>
								<uc:SidebarListView x:Name="translationsUC"
								                    Margin="5"
								                    Title="Translations"
								                    ShowDuplicateButton="False"
								                    ShowImportButton="True"
								                    ShowExportButton="True"/>
							</StackPanel>
						</StackPanel>
					</ScrollViewer>
				</Border>
				<!-- Collapsed: full strip (behind toggle) expands pane; vertical title uses layout transform. -->
				<Border x:Name="SidebarCollapsedStrip"
				        HorizontalAlignment="Stretch"
				        VerticalAlignment="Stretch"
				        Background="Transparent"
				        BorderBrush="#CCFFFFFF"
				        BorderThickness="0,0,2,0"
				        Cursor="Hand"
				        IsVisible="False"
				        ToolTip.Tip="Click to expand Components"
				        PointerPressed="SidebarCollapsedStrip_PointerPressed">
					<LayoutTransformControl HorizontalAlignment="Center"
					                        VerticalAlignment="Center">
						<LayoutTransformControl.LayoutTransform>
							<RotateTransform Angle="-90"/>
						</LayoutTransformControl.LayoutTransform>
						<TextBlock Text="Components"
						           FontWeight="Bold"
						           FontSize="13"
						           Foreground="White"
						           TextWrapping="NoWrap"
						           TextTrimming="None"
						           TextAlignment="Center"/>
					</LayoutTransformControl>
				</Border>
				<Button x:Name="SidebarPaneToggleButton"
				        Classes="iconbutton"
				        Content="«"
				        Width="32"
				        Height="32"
				        Padding="0"
				        HorizontalAlignment="Left"
				        VerticalAlignment="Top"
				        Margin="6,4,0,0"
				        Click="SidebarPaneToggleButton_Click"
				        ToolTip.Tip="Collapse sidebar"/>
			</Grid>

			<!-- Tile block list + floating toggle -->
			<Grid x:Name="TileBlockPaneGrid"
			      Grid.Column="1"
			      Background="{StaticResource bgColorLight}"
			      ClipToBounds="False">
				<Border x:Name="TileBlockContentHost"
				        Background="{StaticResource bgColorLight}"
				        Padding="4,0,4,4">
					<ScrollViewer x:Name="TileBlockScrollViewer"
					              VerticalScrollBarVisibility="Auto"
					              HorizontalScrollBarVisibility="Disabled"
					              VerticalAlignment="Stretch"
					              Background="{StaticResource bgColorLight}">
						<StackPanel Spacing="0">
							<TextBlock x:Name="TileBlockTitleHorizontal"
							           Text="Tile Blocks"
							           FontWeight="Bold"
							           FontSize="14"
							           Foreground="White"
							           HorizontalAlignment="Stretch"
							           TextAlignment="Center"
							           Margin="8,4,8,10"/>
							<Rectangle Height="1"
							           Fill="White"
							           HorizontalAlignment="Stretch"
							           Margin="4,0,4,10"/>
							<ItemsControl x:Name="TileBlockItemsControl"
							              Padding="5"
							              ItemsSource="{Binding chapterObserver}"
							              HorizontalAlignment="Stretch">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Vertical"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate DataType="jime:Chapter">
										<Border Classes="callout tileBlockCard" Margin="0,0,5,5" MinWidth="240">
											<StackPanel Spacing="4">
												<Grid ColumnDefinitions="Auto,*">
													<Border Grid.Column="0"
													        Background="Transparent"
													        Padding="2,0,4,0"
													        VerticalAlignment="Center"
													        Cursor="SizeAll"
													        IsVisible="{Binding isStart, Converter={StaticResource chapterStartInvert}}"
													        PointerPressed="TileBlockDragHandle_PointerPressed"
													        ToolTip.Tip="Drag to reorder">
														<TextBlock Text="⋮⋮"
														           Foreground="#AAAAAA"
														           FontSize="14"
														           VerticalAlignment="Center"/>
													</Border>
													<TextBlock Grid.Column="1"
													           Text="{Binding dataName}"
													           Classes="heading"
													           TextTrimming="CharacterEllipsis"
													           HorizontalAlignment="Center"
													           VerticalAlignment="Center"/>
												</Grid>
												<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
													<Button Background="DodgerBlue"
													        Margin="2,5"
													        Click="TileEditButton_Click"
													        DataContext="{Binding}">
														<TextBlock Foreground="White" Text="Tile Editor..."/>
													</Button>
													<Button Background="DodgerBlue"
													        Margin="2,5"
													        Click="ChapterPropsButton_Click"
													        DataContext="{Binding}">
														<TextBlock Foreground="White" Text="Properties..."/>
													</Button>
												</StackPanel>
												<Button Background="{StaticResource bgCancelDelete}"
												        HorizontalAlignment="Stretch"
												        Click="RemoveChapterButton_Click"
												        DataContext="{Binding}"
												        IsEnabled="{Binding isStart, Converter={StaticResource chapterStartInvert}}">
													<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
														<TextBlock Foreground="White" Text="Remove Block" VerticalAlignment="Center"/>
														<Image Source="avares://JiMEditor.Avalonia/Assets/cancel.png" Width="24"/>
													</StackPanel>
												</Button>
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</ScrollViewer>
				</Border>
				<Border x:Name="TileBlockCollapsedStrip"
				        HorizontalAlignment="Stretch"
				        VerticalAlignment="Stretch"
				        Background="Transparent"
				        Cursor="Hand"
				        IsVisible="False"
				        ToolTip.Tip="Click to expand Tile Blocks"
				        PointerPressed="TileBlockCollapsedStrip_PointerPressed">
					<LayoutTransformControl HorizontalAlignment="Center"
					                        VerticalAlignment="Center">
						<LayoutTransformControl.LayoutTransform>
							<RotateTransform Angle="-90"/>
						</LayoutTransformControl.LayoutTransform>
						<TextBlock Text="Tile Blocks"
						           FontWeight="Bold"
						           FontSize="13"
						           Foreground="White"
						           TextWrapping="NoWrap"
						           TextTrimming="None"
						           TextAlignment="Center"/>
					</LayoutTransformControl>
				</Border>
				<Button x:Name="TileBlockPaneToggleButton"
				        Classes="iconbutton"
				        Content="«"
				        Width="32"
				        Height="32"
				        Padding="0"
				        HorizontalAlignment="Left"
				        VerticalAlignment="Top"
				        Margin="6,4,0,0"
				        Click="TileBlockPaneToggleButton_Click"
				        ToolTip.Tip="Collapse tile blocks"/>
				<Border x:Name="TileBlockDragGhost"
				        Classes="callout tileBlockCard tileBlockDragGhost"
				        HorizontalAlignment="Left"
				        VerticalAlignment="Top"
				        MinWidth="240"
				        IsVisible="False"
				        IsHitTestVisible="False"
				        ZIndex="100">
					<TextBlock x:Name="TileBlockDragGhostTitle"
					           Classes="heading"
					           TextTrimming="CharacterEllipsis"
					           HorizontalAlignment="Center"
					           VerticalAlignment="Center"/>
				</Border>
			</Grid>

			<Border Grid.Column="2"
			        Background="#FF1E1E1E"
			        BorderBrush="{StaticResource bgButtonColor}"
			        BorderThickness="1"
			        Margin="8"
			        ClipToBounds="True">
				<flowPreview:ScenarioChapterFlowGraphView x:Name="ScenarioChapterFlowGraph" />
			</Border>
		</Grid>
	</DockPanel>
</Window>
