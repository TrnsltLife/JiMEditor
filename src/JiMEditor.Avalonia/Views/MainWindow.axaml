<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:jime="using:JiME"
        xmlns:uc="using:JiMEditor.Avalonia.UserControls"
        mc:Ignorable="d"
        d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="JiMEditor.Avalonia.Views.MainWindow"
        x:CompileBindings="False"
        Background="{StaticResource bgColor}"
        Width="1200" Height="750">
	<!--
		Original WPF GraphX region (JiMEditor/MainWindow.xaml) — TODO-Avalonia-Reenable: replace with Avalonia graph or alternate layout.
		<zoom:ZoomControl x:Name="zoomControl" Grid.Row="1" Grid.Column="1" ZoomBoxVisibility="Collapsed" Background="#FF1E1E1E">
			<local:GraphArea x:Name="graphArea" />
		</zoom:ZoomControl>
	-->

	<DockPanel LastChildFill="True">
		<!-- Toolbar -->
		<Border DockPanel.Dock="Top" Background="{StaticResource bgColorLight}" Padding="6">
			<StackPanel Orientation="Horizontal" Spacing="4">
				<Button Classes="iconbutton" Height="32" Padding="4,0,4,0" IsEnabled="False" ToolTip.Tip="New scenario (TODO)">
					<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
						<Image Source="avares://JiMEditor.Avalonia/Assets/newcampaign.png" Width="24" Height="24"/>
					</StackPanel>
				</Button>
				<Button Classes="iconbutton" Height="32" Padding="4,0,4,0" IsEnabled="False" ToolTip.Tip="Open (TODO)">
					<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
						<Image Source="avares://JiMEditor.Avalonia/Assets/open.png" Width="24" Height="24"/>
					</StackPanel>
				</Button>
				<Button Classes="iconbutton" Height="32" Padding="4,0,4,0" IsEnabled="False" ToolTip.Tip="Save (TODO)">
					<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
						<Image Source="avares://JiMEditor.Avalonia/Assets/save.png" Width="24" Height="24"/>
					</StackPanel>
				</Button>
				<Rectangle Width="1" Height="24" Fill="{StaticResource bgButtonColor}" Margin="4,0"/>
				<Grid Width="200" VerticalAlignment="Center">
					<TextBlock x:Name="ScenarioNameText"
					           Text="{Binding scenarioName}"
					           Foreground="White"
					           FontWeight="Bold"
					           FontSize="15"
					           VerticalAlignment="Center"
					           TextTrimming="CharacterEllipsis"
					           PointerPressed="ScenarioNameText_PointerPressed"/>
					<TextBox x:Name="ScenarioNameEdit"
					         Width="200"
					         Classes="campaignField"
					         FontSize="15"
					         IsVisible="False"
					         KeyDown="ScenarioNameEdit_KeyDown"
					         LostFocus="ScenarioNameEdit_LostFocus"/>
				</Grid>
				<Button Classes="iconbutton" Height="32" Padding="4,0,4,0" Click="ScenarioSettingsButton_Click" ToolTip.Tip="Edit scenario settings">
					<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
						<Image Source="avares://JiMEditor.Avalonia/Assets/settings.png" Width="24" Height="24"/>
						<TextBlock Text="Settings" Foreground="White" FontSize="12" Margin="4,6,0,0"/>
					</StackPanel>
				</Button>
				<Button Classes="iconbutton" Height="32" Padding="4,0,4,0" Click="ThreatsToolbarButton_Click" ToolTip.Tip="Edit threat settings">
					<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
						<Image Source="avares://JiMEditor.Avalonia/Assets/threat_button.png" Width="24" Height="24"/>
						<TextBlock Text="Threat" Foreground="White" FontSize="12" Margin="4,6,0,0"/>
					</StackPanel>
				</Button>
				<Rectangle Width="1" Height="24" Fill="{StaticResource bgButtonColor}" Margin="4,0"/>
				<Button Classes="iconbutton" Height="32" Padding="4,0,4,0" IsEnabled="False" ToolTip.Tip="Add tile block (TODO)">
					<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
						<Image Source="avares://JiMEditor.Avalonia/Assets/addtileblock.png" Width="24" Height="24"/>
						<TextBlock Text="New Tile Block" Foreground="White" FontSize="12" Margin="4,6,0,0"/>
					</StackPanel>
				</Button>
				<Button x:Name="AddObjectiveToolbarButton"
				        Classes="iconbutton"
				        Height="32"
				        Padding="4,0,4,0"
				        Click="AddObjectiveToolbarButton_Click"
				        ToolTip.Tip="New objective">
					<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
						<Image Source="avares://JiMEditor.Avalonia/Assets/addobjective.png" Width="24" Height="24"/>
						<TextBlock Text="New Objective" Foreground="White" FontSize="12" Margin="4,6,0,0"/>
					</StackPanel>
				</Button>
				<Button x:Name="AddEventToolbarButton"
				        Classes="iconbutton"
				        Height="32"
				        Padding="4,0,4,0"
				        Click="AddEventToolbarButton_Click"
				        ToolTip.Tip="New event">
					<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
						<Image Source="avares://JiMEditor.Avalonia/Assets/addevent.png" Width="24" Height="24"/>
						<TextBlock Text="New Event" Foreground="White" FontSize="12" Margin="4,6,0,0"/>
					</StackPanel>
				</Button>
				<Button x:Name="AddTriggerToolbarButton"
				        Classes="iconbutton"
				        Height="32"
				        Padding="4,0,4,0"
				        Click="AddTriggerToolbarButton_Click"
				        ToolTip.Tip="New trigger">
					<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
						<Image Source="avares://JiMEditor.Avalonia/Assets/addtrigger.png" Width="24" Height="24"/>
						<TextBlock Text="New Trigger" Foreground="White" FontSize="12" Margin="4,6,0,0"/>
					</StackPanel>
				</Button>
			</StackPanel>
		</Border>

		<!-- Status bar -->
		<Border DockPanel.Dock="Bottom" Background="{StaticResource bgColorLight}" Padding="8,4">
			<TextBlock x:Name="StatusText" Foreground="White" Text="Ready"/>
		</Border>

		<!-- Sidebar + main -->
		<Grid ColumnDefinitions="260,*">
			<!-- Left sidebar lists -->
			<Border Grid.Column="0" Background="{StaticResource bgColorLight}" Padding="4">
				<ScrollViewer>
					<StackPanel Spacing="8">
						<uc:SidebarListView x:Name="objectivesUC"
						                    Margin="5"
						                    Title="Objectives"
						                    ShowDuplicateButton="True"
						                    ShowImportButton="False"
						                    ShowExportButton="False"/>
						<uc:SidebarListView x:Name="interactionsUC"
						                    Margin="5"
						                    Title="Events"
						                    ShowDuplicateButton="True"
						                    ShowImportButton="True"
						                    ShowExportButton="True"/>
						<uc:SidebarListView x:Name="triggersUC"
						                    Margin="5"
						                    Title="Triggers"
						                    ShowDuplicateButton="True"
						                    ShowImportButton="False"
						                    ShowExportButton="False"/>
						<uc:SidebarListView x:Name="activationsUC"
						                    Margin="5"
						                    Title="Enemy Attack Groups"
						                    ShowDuplicateButton="True"
						                    ShowImportButton="True"
						                    ShowExportButton="True"/>
						<uc:SidebarListView x:Name="monsterModifiersUC"
						                    Margin="5"
						                    Title="Enemy Bonuses"
						                    ShowDuplicateButton="True"
						                    ShowImportButton="True"
						                    ShowExportButton="True"/>
						<uc:SidebarListView x:Name="translationsUC"
						                    Margin="5"
						                    Title="Translations"
						                    ShowDuplicateButton="False"
						                    ShowImportButton="True"
						                    ShowExportButton="True"/>
					</StackPanel>
				</ScrollViewer>
			</Border>

			<!-- Main: chapters + graph placeholder -->
			<Grid Grid.Column="1" RowDefinitions="Auto,*">
				<Border Grid.Row="0" Background="{StaticResource bgColor}" Padding="8">
					<StackPanel>
						<TextBlock Text="Chapters" Foreground="White" FontWeight="Bold" Margin="0,0,0,4"/>
						<ItemsControl ItemsSource="{Binding chapterObserver}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Horizontal" Spacing="8"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="jime:Chapter">
									<Border Classes="callout" MinWidth="120">
										<TextBlock Text="{Binding dataName}" Foreground="White" TextWrapping="Wrap"/>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Border>

				<Border Grid.Row="1" Background="#FF1E1E1E" BorderBrush="{StaticResource bgButtonColor}" BorderThickness="1" Margin="8">
					<TextBlock Text="Map / graph (GraphX not ported — see comment in MainWindow.axaml)" Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="16"/>
				</Border>
			</Grid>
		</Grid>
	</DockPanel>
</Window>
