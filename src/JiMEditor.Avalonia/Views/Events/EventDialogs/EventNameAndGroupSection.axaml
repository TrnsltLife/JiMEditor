<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JiMEditor.Avalonia.Views.Events.EventDialogs.EventNameAndGroupSection"
             x:CompileBindings="False">
	<Border Classes="callout">
		<Grid ColumnDefinitions="*,*">
			<StackPanel Grid.Column="0">
				<TextBlock Classes="heading" Text="Event Name:"/>
				<TextBlock Classes="subText" TextWrapping="Wrap">
					A short name used within the Editor. <Run FontStyle="Italic" FontWeight="Bold">Required</Run>
				</TextBlock>
				<TextBox x:Name="NameTextBox"
				         Width="250"
				         HorizontalAlignment="Left"
				         Margin="0,5"
				         Classes="campaignField"
				         TextChanged="NameTextBox_OnTextChanged"/>
			</StackPanel>
			<StackPanel Grid.Column="1" Orientation="Vertical">
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<Button x:Name="GroupHelpButton"
					        Width="32"
					        Height="32"
					        Margin="10,0,0,0"
					        Background="#FFC98800"
					        Click="GroupHelpButton_OnClick">
						<Image Source="avares://JiMEditor.Avalonia/Assets/help.png" Stretch="Uniform"/>
					</Button>
					<StackPanel Margin="10,0,0,0">
						<TextBlock Classes="subText"
						           Text="You can place this Event into a Random Interaction Group."
						           TextWrapping="Wrap"
						           Width="290"/>
						<TextBlock x:Name="GroupInfoText"
						           Margin="0,5,0,0"
						           Classes="subText"
						           Text="This Event is in the following group: None"/>
					</StackPanel>
				</StackPanel>
				<CheckBox x:Name="IsReusableCheckBox"
				          Margin="32,20,0,0"
				          Foreground="White"
				          Content="This grouped Event can be used more than once"
				          IsVisible="False"/>
			</StackPanel>
		</Grid>
	</Border>
</UserControl>
