<!-- Ported from: JiMEditor/Views/Interactions/ReplaceTokenInteractionWindow.xaml — Replace Token tab (2026-04-17). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JiMEditor.Avalonia.Views.Events.EventDialogs.ReplaceTokenCustomTab"
             x:CompileBindings="False">
	<ScrollViewer Margin="0,5,0,0"
	              HorizontalScrollBarVisibility="Disabled"
	              VerticalScrollBarVisibility="Auto">
		<StackPanel Spacing="10">
			<Border Classes="callout">
				<TextBlock Classes="subText"
				           TextWrapping="Wrap"
				           VerticalAlignment="Center"
				           Text="This Event, when triggered, will replace an existing Token on the board with another Token you specify here. The Token type image (Search, Person, etc) will also be replaced. Only Events that are NOT in a random group and have 'Token Interaction' checked are valid sources and targets for replacement."/>
			</Border>

			<Border x:Name="NoTextBorder"
			        Classes="callout"
			        Margin="0,10,0,0">
				<Grid ColumnDefinitions="Auto,*">
					<CheckBox x:Name="NoTextCheckBox"
					          Foreground="White"
					          VerticalAlignment="Center"
					          Content="Don't Use Flavor/Event Text"/>
					<TextBlock Grid.Column="1"
					           Classes="subText"
					           TextWrapping="Wrap"
					           HorizontalAlignment="Right"
					           Margin="10,0,0,0"
					           Text="With this option checked, neither the Flavor nor Event Text will show when this Event is activated. Instead, it will silently perform its Token replacement without displaying any text other than letting the Players know which Token to replace."/>
				</Grid>
			</Border>

			<Border Classes="callout" Margin="0,10,0,0">
				<StackPanel Spacing="8">
					<Grid ColumnDefinitions="*,*" RowDefinitions="Auto" Margin="0,0,0,5">
						<StackPanel Grid.Column="0" Margin="10,0,0,0" Spacing="4">
							<TextBlock Classes="heading"
							           Text="Target (required)"
							           VerticalAlignment="Center"
							           TextWrapping="Wrap"/>
							<TextBlock Classes="heading" Text="Replace this Event:"/>
						</StackPanel>
						<StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="4">
							<TextBlock Classes="heading"
							           Text="Source (required)"
							           VerticalAlignment="Center"
							           TextWrapping="Wrap"/>
							<TextBlock Classes="heading" Text="...with this Event:"/>
						</StackPanel>
					</Grid>
					<Grid ColumnDefinitions="*,*" RowDefinitions="Auto">
						<StackPanel Grid.Column="0"
						            Orientation="Horizontal"
						            Spacing="8"
						            Margin="10,0,0,0">
							<ComboBox x:Name="EventToReplaceCombo"
							          MinWidth="300"
							          HorizontalAlignment="Left">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding dataName}" Foreground="White"/>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
							<Button x:Name="AddEventToReplaceButton"
							        Background="#3CB371"
							        Width="32"
							        Height="32"
							        Padding="4"
							        VerticalAlignment="Center"
							        Click="AddEventToReplaceButton_OnClick">
								<Image Source="avares://JiMEditor.Avalonia/Assets/add2.png" Stretch="Uniform"/>
							</Button>
						</StackPanel>
						<StackPanel Grid.Column="1"
						            Orientation="Horizontal"
						            Spacing="8"
						            Margin="10,0,0,0">
							<ComboBox x:Name="ReplaceWithCombo"
							          MinWidth="300"
							          HorizontalAlignment="Left">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding dataName}" Foreground="White"/>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
							<Button x:Name="AddReplaceWithButton"
							        Background="#3CB371"
							        Width="32"
							        Height="32"
							        Padding="4"
							        VerticalAlignment="Center"
							        Click="AddReplaceWithButton_OnClick">
								<Image Source="avares://JiMEditor.Avalonia/Assets/add2.png" Stretch="Uniform"/>
							</Button>
						</StackPanel>
					</Grid>
					<TextBlock Classes="subText"
					           TextWrapping="Wrap"
					           VerticalAlignment="Center"
					           Margin="0,5,0,0"
					           Text="If the Target Event's Token is invisible until 'Triggered By' a Trigger in the Token Editor, the Source Event will automatically pick up this Trigger and use it."/>
					<TextBlock Classes="subText"
					           TextWrapping="Wrap"
					           VerticalAlignment="Center"
					           Margin="0,5,0,0"
					           Text="Do not use the Source Event anywhere else unless you know what you're doing. Multiple identical Events could be confusing to players and also potentially cause unexpected results in the Companion App."/>
				</StackPanel>
			</Border>
		</StackPanel>
	</ScrollViewer>
</UserControl>
