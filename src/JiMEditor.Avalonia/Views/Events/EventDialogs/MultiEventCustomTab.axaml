<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JiMEditor.Avalonia.Views.Events.EventDialogs.MultiEventCustomTab"
             x:CompileBindings="False">
	<ScrollViewer Margin="0,5,0,0"
	              HorizontalScrollBarVisibility="Disabled"
	              VerticalScrollBarVisibility="Auto">
	<StackPanel Spacing="10">
		<Border Classes="callout">
			<TextBlock Classes="subText" TextWrapping="Wrap"
			           Text="Multi-Events activate a sequence of Triggers or Events in order. Build one list below (Triggers OR Events)."/>
		</Border>

		<Border Classes="callout">
			<StackPanel Spacing="6">
				<TextBlock Classes="heading" Text="Silently Activate"/>
				<CheckBox x:Name="SilentCheckBox"
				          Content="This Event activates silently without showing Event Text."
				          IsChecked="True"
				          IsThreeState="False"
				          Checked="SilentCheckBox_OnChanged"
				          Unchecked="SilentCheckBox_OnChanged"/>
				<TextBlock Classes="subText" TextWrapping="Wrap"
				           Text="If enabled, this event fires its configured Triggers/Events without showing its own Event Text."/>
			</StackPanel>
		</Border>

		<Border Classes="callout">
		<StackPanel Spacing="6">
		<StackPanel Orientation="Horizontal" Spacing="12">
			<RadioButton x:Name="TriggerModeRadio"
			             GroupName="multiMode"
			             Content="Use Triggers"
			             Checked="ModeRadio_OnChanged"
			             Unchecked="ModeRadio_OnChanged"/>
			<RadioButton x:Name="EventModeRadio"
			             GroupName="multiMode"
			             Content="Use Events"
			             Checked="ModeRadio_OnChanged"
			             Unchecked="ModeRadio_OnChanged"/>
		</StackPanel>
		<TextBlock Classes="subText" TextWrapping="Wrap"
		           Text="Only one mode is active at a time; the other list is ignored when this event fires."/>
		</StackPanel>
		</Border>

		<Border x:Name="TriggerModeBox" Classes="callout">
			<StackPanel Spacing="6">
				<Grid ColumnDefinitions="Auto,*,Auto">
					<TextBlock Classes="heading" Text="Fire These Triggers:"/>
					<TextBlock Grid.Column="1"/>
					<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
						<ComboBox x:Name="TriggerSelectCombo" MinWidth="260" SelectionChanged="TriggerSelectCombo_OnSelectionChanged">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding dataName}" Foreground="White"/>
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
						<Button x:Name="AddSelectedTriggerButton"
						        Content="Add Selected Trigger"
						        Background="#1E90FF"
						        Foreground="White"
						        IsEnabled="False"
						        Click="AddSelectedTriggerButton_OnClick"/>
						<Button x:Name="AddTriggerButton"
						        Background="#3CB371"
						        Width="32"
						        Height="32"
						        Padding="4"
						        Click="AddTriggerButton_OnClick">
							<Image Source="avares://JiMEditor.Avalonia/Assets/add2.png" Stretch="Uniform"/>
						</Button>
					</StackPanel>
				</Grid>
				<ItemsControl x:Name="SelectedTriggersItems">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Classes="callout" Background="{StaticResource bgButtonColor}" Margin="0,0,6,6">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<TextBlock Classes="subText" Text="{Binding}" VerticalAlignment="Center"/>
									<Button Width="32"
									        Height="32"
									        Padding="4"
									        Background="{StaticResource bgCancelDelete}"
									        Click="RemoveTriggerButton_OnClick"
									        CommandParameter="{Binding}">
										<Image Source="avares://JiMEditor.Avalonia/Assets/cancel.png" Stretch="Uniform"/>
									</Button>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</Border>

		<TextBlock Classes="heading" Text="-OR-" HorizontalAlignment="Center"/>

		<Border x:Name="EventModeBox" Classes="callout">
			<StackPanel Spacing="6">
				<Grid ColumnDefinitions="Auto,*,Auto">
					<TextBlock Classes="heading" Text="Fire These Events:"/>
					<TextBlock Grid.Column="1"/>
					<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
						<ComboBox x:Name="EventSelectCombo" MinWidth="280" SelectionChanged="EventSelectCombo_OnSelectionChanged"/>
						<Button x:Name="AddSelectedEventButton"
						        Content="Add Selected Event"
						        Background="#1E90FF"
						        Foreground="White"
						        IsEnabled="False"
						        Click="AddSelectedEventButton_OnClick"/>
						<Button x:Name="AddEventButton"
						        Background="#3CB371"
						        Width="32"
						        Height="32"
						        Padding="4"
						        Click="AddEventButton_OnClick">
							<Image Source="avares://JiMEditor.Avalonia/Assets/add2.png" Stretch="Uniform"/>
						</Button>
					</StackPanel>
				</Grid>
				<ItemsControl x:Name="SelectedEventsItems">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Classes="callout" Background="{StaticResource bgButtonColor}" Margin="0,0,6,6">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<TextBlock Classes="subText" Text="{Binding}" VerticalAlignment="Center"/>
									<Button Width="32"
									        Height="32"
									        Padding="4"
									        Background="{StaticResource bgCancelDelete}"
									        Click="RemoveEventButton_OnClick"
									        CommandParameter="{Binding}">
										<Image Source="avares://JiMEditor.Avalonia/Assets/cancel.png" Stretch="Uniform"/>
									</Button>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</Border>
	</StackPanel>
	</ScrollViewer>
</UserControl>
