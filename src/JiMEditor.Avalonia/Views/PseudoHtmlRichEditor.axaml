<!-- Source + live preview editor for JiME pseudo-HTML (2026-04-05) -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JiMEditor.Avalonia.Views.PseudoHtmlRichEditor"
             x:Name="Root"
             x:CompileBindings="False">
	<UserControl.Styles>
		<!-- Add right inset inside the TextBox viewport so content is not obscured by the vertical scrollbar. -->
		<Style Selector="TextBox.markupBox /template/ ScrollViewer#PART_ScrollViewer">
			<Setter Property="Padding" Value="0,0,32,0"/>
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,*" MinHeight="160">
		<ScrollViewer Grid.Row="0"
		              HorizontalScrollBarVisibility="Auto"
		              VerticalScrollBarVisibility="Disabled"
		              Margin="0,0,0,6">
			<StackPanel Orientation="Horizontal" Spacing="4">
				<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
					<!-- Focusable=false: keep focus in SourceBox so B/I/Clear see the text selection instead of a collapsed caret. -->
					<Button x:Name="BoldButton" Focusable="False" Classes="projectChromeButton" HorizontalContentAlignment="Center" Content="B" FontWeight="Bold" FontSize="12" Padding="4,4,4,4" MinWidth="20" Click="Bold_Click"/>
					<Button x:Name="ItalicButton" Focusable="False" Classes="projectChromeButton" HorizontalContentAlignment="Center" Content="I" FontStyle="Italic" FontSize="12" Padding="4,4,4,4" MinWidth="20" Click="Italic_Click"/>
					<Button x:Name="ClearFmtButton" Focusable="False" Classes="projectChromeButton" HorizontalContentAlignment="Center" Content="Clear" MinWidth="40" FontSize="12" Padding="4,4,4,4" Click="ClearFmt_Click"/>
				</StackPanel>
				<StackPanel Orientation="Vertical" Spacing="4" VerticalAlignment="Top">
					<!-- Row template: each item here is one toolbar row (array of groups). -->
					<ItemsControl x:Name="IconToolbarRows">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Spacing="4"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<StackPanel Orientation="Horizontal">
									<!-- Group template: each item here is one button group within the current row. -->
									<ItemsControl ItemsSource="{Binding}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<StackPanel Orientation="Horizontal" Spacing="10"/>
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<!-- Button template: each item here is one glyph button within the current group. -->
												<ItemsControl ItemsSource="{Binding}">
													<ItemsControl.ItemsPanel>
														<ItemsPanelTemplate>
															<StackPanel Orientation="Horizontal" Spacing="2"/>
														</ItemsPanelTemplate>
													</ItemsControl.ItemsPanel>
													<ItemsControl.ItemTemplate>
														<DataTemplate>
															<Button Focusable="False"
																	Classes="projectChromeButton"
																	Content="{Binding}"
																	FontFamily="avares://JiMEditor.Avalonia/Assets/LoTR-JiME-Icons.ttf#LoTR JiME Icons"
																	MinWidth="20"
																	Padding="4,4,4,4"
																	Click="IconGlyph_Click"/>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</StackPanel>
		</ScrollViewer>

		<Grid Grid.Row="1" ColumnDefinitions="*,8,*" MinHeight="80">
			<DockPanel Grid.Column="0">
				<TextBlock DockPanel.Dock="Top"
				           Text="Markup (saved to .jime)"
				           Foreground="White"
				           FontSize="11"
				           Opacity="0.85"
				           Margin="0,0,0,4"/>
				<TextBox x:Name="SourceBox"
				         Classes="markupBox"
				         AcceptsReturn="True"
				         TextWrapping="WrapWithOverflow"
				         Padding="0"
						 Margin="0"
						 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
						 ScrollViewer.VerticalScrollBarVisibility="Visible"
				         FontFamily="Consolas,Courier New,monospace"
				         Foreground="White"
				         Background="#2a2a2e"
				         Watermark="{Binding Watermark, ElementName=Root}"
				         TextChanged="SourceBox_OnTextChanged"/>
			</DockPanel>
			<GridSplitter Grid.Column="1"
			              Width="8"
			              Background="#555"/>

			<DockPanel Grid.Column="2">
				<TextBlock DockPanel.Dock="Top"
				           Text="Preview"
				           Foreground="White"
				           FontSize="11"
				           Opacity="0.85"
				           Margin="0,0,0,4"/>
				<!-- Horizontal scroll off so PreviewBlock gets a bounded width and TextWrapping applies. -->
				<ScrollViewer HorizontalScrollBarVisibility="Disabled"
				              VerticalScrollBarVisibility="Auto">
					<TextBlock x:Name="PreviewBlock"
					           TextWrapping="Wrap"
					           Margin="0,0,20,0"
					           Foreground="White"
					           FontSize="14"/>
				</ScrollViewer>
			</DockPanel>
		</Grid>
	</Grid>
</UserControl>
