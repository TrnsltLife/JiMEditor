<!-- Ported from: JiMEditor/Views/MonsterModifierEditorWindow.xaml (2026-04-06) — Avalonia UI. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="JiMEditor.Avalonia.Views.MonsterModifierEditorWindow"
        x:CompileBindings="False"
        Title="Monster Bonus Editor"
        Width="750"
        MinWidth="640"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource bgColor}">

	<Window.Styles>
		<Style Selector="TextBox.campaignField">
			<Setter Property="Background" Value="#333337"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="#77777d"/>
			<Setter Property="Padding" Value="6,4"/>
		</Style>
		<Style Selector="CheckBox">
			<Setter Property="Foreground" Value="White"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="*,Auto">
		<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="8">
				<Border Classes="callout" Margin="0,10,0,0">
					<Grid ColumnDefinitions="*,*">
						<StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
							<TextBlock Classes="heading" Text="Monster Bonus Name (in-game):"/>
							<TextBlock Classes="subText" TextWrapping="Wrap"
							           Text="Displayed in the Combat Panel in the game. Required (in-game name)."/>
							<TextBox x:Name="NameTextBox"
							         Classes="campaignField"
							         Width="250"
							         HorizontalAlignment="Left"
							         Margin="0,5,0,0"
							         Text="{Binding shortName, Mode=TwoWay}"/>
						</StackPanel>
						<StackPanel Grid.Column="1" Spacing="4">
							<TextBlock Classes="heading" Text="In-Editor Name:"/>
							<TextBlock Classes="subText" TextWrapping="Wrap"
							           Text="Only displayed in the editor. Use it to distinguish bonuses that have the same in-game names."/>
							<TextBox x:Name="DataNameTextBox"
							         Classes="campaignField"
							         Width="250"
							         HorizontalAlignment="Left"
							         Margin="0,5,0,0"/>
						</StackPanel>
					</Grid>
				</Border>

				<StackPanel Spacing="8" Margin="0,10,0,0">
					<TextBlock Classes="heading" Text="Bonuses" FontSize="14"/>
					<Border Classes="callout">
						<StackPanel Spacing="12">
								<UniformGrid Columns="5" Margin="0,0,0,8">
									<StackPanel Orientation="Horizontal" Spacing="8">
										<TextBlock Classes="heading" Text="Health" VerticalAlignment="Center"/>
										<TextBox x:Name="HealthTextBox" Classes="campaignField" Width="40"/>
									</StackPanel>
									<StackPanel Orientation="Horizontal" Spacing="8">
										<TextBlock Classes="heading" Text="Armor" VerticalAlignment="Center"/>
										<TextBox x:Name="ArmorTextBox" Classes="campaignField" Width="40"/>
									</StackPanel>
									<StackPanel Orientation="Horizontal" Spacing="8">
										<TextBlock Classes="heading" Text="Sorcery" VerticalAlignment="Center"/>
										<TextBox x:Name="SorceryTextBox" Classes="campaignField" Width="40"/>
									</StackPanel>
									<StackPanel Orientation="Horizontal" Spacing="8">
										<TextBlock Classes="heading" Text="Damage" VerticalAlignment="Center"/>
										<TextBox x:Name="DamageTextBox" Classes="campaignField" Width="40"/>
									</StackPanel>
									<StackPanel Orientation="Horizontal" Spacing="8">
										<TextBlock Classes="heading" Text="Fear" VerticalAlignment="Center"/>
										<TextBox x:Name="FearTextBox" Classes="campaignField" Width="40"/>
									</StackPanel>
								</UniformGrid>

								<Grid ColumnDefinitions="*,*">
									<StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
										<TextBlock Classes="heading" Text="Immunity"/>
										<TextBlock Classes="subText" TextWrapping="Wrap"
										           Text="The enemy will be immune to the following effects."/>
										<CheckBox x:Name="ImmuneCleaveCheck" Content="Cleave"/>
										<CheckBox x:Name="ImmuneLethalCheck" Content="Lethal"/>
										<CheckBox x:Name="ImmunePierceCheck" Content="Pierce"/>
										<CheckBox x:Name="ImmuneSmiteCheck" Content="Smite"/>
										<CheckBox x:Name="ImmuneStunCheck" Content="Stun"/>
										<CheckBox x:Name="ImmuneSunderCheck" Content="Sunder"/>
									</StackPanel>
									<StackPanel Grid.Column="1" Spacing="4">
										<TextBlock Classes="heading" Text="Feigned Immunity"/>
										<TextBlock Classes="subText" TextWrapping="Wrap"
										           Text="The game will describe the enemy as being immune, but there will be no actual effect."/>
										<CheckBox x:Name="FakeCleaveCheck" Content="Cleave"/>
										<CheckBox x:Name="FakeLethalCheck" Content="Lethal"/>
										<CheckBox x:Name="FakePierceCheck" Content="Pierce"/>
										<CheckBox x:Name="FakeSmiteCheck" Content="Smite"/>
										<CheckBox x:Name="FakeStunCheck" Content="Stun"/>
										<CheckBox x:Name="FakeSunderCheck" Content="Sunder"/>
									</StackPanel>
								</Grid>
						</StackPanel>
					</Border>
				</StackPanel>
			</StackPanel>
		</ScrollViewer>

		<Border Grid.Row="1"
		        BorderThickness="0,1,0,0"
		        BorderBrush="Silver"
		        Background="#FF46464A">
			<WrapPanel HorizontalAlignment="Right">
				<Button x:Name="OkButton"
				        Margin="10"
				        Background="MediumSeaGreen"
				        Click="OkButton_Click"
				        IsDefault="True">
					<Image Source="avares://JiMEditor.Avalonia/Assets/ok.png" Stretch="Uniform" Width="32" Margin="5"/>
				</Button>
				<Button x:Name="CancelButton"
				        Margin="0,10,10,10"
				        Background="{StaticResource bgCancelDelete}"
				        Click="CancelButton_Click"
				        IsCancel="True">
					<Image Source="avares://JiMEditor.Avalonia/Assets/cancel.png" Stretch="Uniform" Width="32" Margin="5"/>
				</Button>
			</WrapPanel>
		</Border>
	</Grid>
</Window>
