<!-- Pseudo-HTML editor for objective summary (one page); mirrors StoryTextEditWindow (2026-04-06). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:JiMEditor.Avalonia.Views"
        x:Class="JiMEditor.Avalonia.Views.ObjectiveSummaryEditWindow"
        x:CompileBindings="False"
        Title="Edit Objective Summary"
        Width="920"
        Height="640"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource bgColor}">

	<DockPanel Margin="12">
		<StackPanel DockPanel.Dock="Bottom"
		            Orientation="Horizontal"
		            HorizontalAlignment="Right"
		            Spacing="10"
		            Margin="0,12,0,0">
			<Button MinWidth="100"
			        Height="36"
			        Classes="projectChromeButton"
			        Click="Cancel_Click"
			        Content="Cancel"/>
			<Button MinWidth="100"
			        Height="36"
			        Background="#3CB371"
			        Content="OK"
			        IsDefault="True"
			        Click="Ok_Click"/>
		</StackPanel>

		<v:PseudoHtmlRichEditor x:Name="Editor"/>
	</DockPanel>
</Window>
