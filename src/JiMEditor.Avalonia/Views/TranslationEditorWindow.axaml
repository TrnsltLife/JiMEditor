<!-- Ported from: JiMEditor/Views/TranslationEditorWindow.xaml (2026-04-06) — Avalonia; list uses TextBlock + row background converter (no FlowDocument). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:JiMEditor.Avalonia.Converters"
        xmlns:jimeui="clr-namespace:JiMEditor.Avalonia"
        x:Class="JiMEditor.Avalonia.Views.TranslationEditorWindow"
        x:CompileBindings="False"
        Title="Translation Editor"
        Width="920"
        MinWidth="800"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource bgColor}">

	<Window.Resources>
		<conv:TranslationItemRowBackgroundConverter x:Key="TransRowBg"/>
		<!-- Flat template so Fluent accent blue never replaces the category color. -->
		<ControlTheme x:Key="TranslationFilterToggleTheme" TargetType="ToggleButton">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Padding" Value="4"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<ControlTemplate>
					<Border Background="{TemplateBinding Background}"
					        BorderBrush="{TemplateBinding BorderBrush}"
					        BorderThickness="{TemplateBinding BorderThickness}"
					        CornerRadius="2"
					        Padding="{TemplateBinding Padding}">
						<ContentPresenter Content="{TemplateBinding Content}"
						                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
						                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
						                  Foreground="{TemplateBinding Foreground}"/>
					</Border>
				</ControlTemplate>
			</Setter>
		</ControlTheme>
	</Window.Resources>

	<Window.Styles>
		<Style Selector="TextBox.campaignField">
			<Setter Property="Background" Value="#333337"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="#77777d"/>
			<Setter Property="Padding" Value="6,4"/>
		</Style>
		<Style Selector="ComboBox">
			<Setter Property="Background" Value="#333337"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<!-- Row colors from TranslationItemRowBackgroundConverter; dim when OFF. -->
		<Style Selector="ToggleButton.translationFilter">
			<Setter Property="Opacity" Value="1"/>
		</Style>
		<Style Selector="ToggleButton.translationFilter:not(:checked)">
			<Setter Property="Opacity" Value="0.4"/>
		</Style>
		<Style Selector="ToggleButton.translationFilterOk">
			<Setter Property="Background" Value="#228B22"/>
		</Style>
		<Style Selector="ToggleButton.translationFilterSuperfluous">
			<Setter Property="Background" Value="#808080"/>
		</Style>
		<Style Selector="ToggleButton.translationFilterNeeds">
			<Setter Property="Background" Value="#FF8C00"/>
		</Style>
		<Style Selector="ToggleButton#TextFilterModeToggle">
			<Setter Property="Background" Value="#55555A"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="*,Auto">
		<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="8" Spacing="6">
				<Grid ColumnDefinitions="*,*">
					<Border Grid.Column="0" Classes="callout" Margin="0,0,6,0">
						<StackPanel Spacing="4">
							<TextBlock Classes="heading" Text="Language Code:"/>
							<TextBlock Classes="subText" TextWrapping="Wrap" Text="2 or 3 letter ISO-639 code (e.g. fr, es)."/>
							<StackPanel Orientation="Horizontal" Spacing="8">
								<TextBox x:Name="LangCodeTextBox" Width="250" Classes="campaignField" Watermark="en, fr, de, …"/>
								<TextBlock Classes="subText" VerticalAlignment="Center"><Run FontWeight="Bold" FontStyle="Italic" Text="Required"/></TextBlock>
							</StackPanel>
						</StackPanel>
					</Border>
					<Border Grid.Column="1" Classes="callout" Margin="6,0,0,0">
						<StackPanel Spacing="4">
							<TextBlock Classes="heading" Text="Language Name:"/>
							<TextBlock Classes="subText" TextWrapping="Wrap" Text="Display name (e.g. Français, Español)."/>
							<StackPanel Orientation="Horizontal" Spacing="8">
								<TextBox x:Name="LangNameTextBox" Width="250" Classes="campaignField"/>
								<TextBlock Classes="subText" VerticalAlignment="Center"><Run FontWeight="Bold" FontStyle="Italic" Text="Required"/></TextBlock>
							</StackPanel>
						</StackPanel>
					</Border>
				</Grid>

				<Border Classes="callout">
					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Grid.Column="0" Classes="subText" TextWrapping="Wrap" Text="Edit each string with the pencil. Toggle the color buttons to show or hide rows (green = OK, orange = needs translation or approval, gray = key no longer in scenario)."/>
					</Grid>
				</Border>

				<Border Classes="callout" Margin="0,2">
					<Grid ColumnDefinitions="0.33*,0.33*,0.34*">
						<ToggleButton x:Name="FilterOkToggle"
						              Grid.Column="0"
						              Theme="{StaticResource TranslationFilterToggleTheme}"
						              Classes="translationFilter translationFilterOk ignoreDirty"
						              Content="Translation OK"
						              IsChecked="True"
						              ToolTip.Tip="Show or hide translations marked OK"
						              IsCheckedChanged="FilterToggle_IsCheckedChanged"/>
						<ToggleButton x:Name="FilterSuperfluousToggle"
						              Grid.Column="1"
						              Theme="{StaticResource TranslationFilterToggleTheme}"
						              Classes="translationFilter translationFilterSuperfluous ignoreDirty"
						              Content="No longer needed / copy?"
						              Margin="2,0"
						              IsChecked="True"
						              ToolTip.Tip="Show or hide keys no longer in the scenario"
						              IsCheckedChanged="FilterToggle_IsCheckedChanged"/>
						<ToggleButton x:Name="FilterNeedsToggle"
						              Grid.Column="2"
						              Theme="{StaticResource TranslationFilterToggleTheme}"
						              Classes="translationFilter translationFilterNeeds ignoreDirty"
						              Content="Needs translation or approval"
						              IsChecked="True"
						              ToolTip.Tip="Show or hide items that still need translation or approval"
						              IsCheckedChanged="FilterToggle_IsCheckedChanged"/>
					</Grid>
				</Border>

				<Border Classes="callout" Margin="0,2">
					<CheckBox x:Name="HideActivationsCheckBox"
					          Classes="ignoreDirty"
					          Content="Hide monster activations"
					          IsChecked="False"
					          Foreground="White"
					          ToolTip.Tip="When checked, hides keys that start with activation."
					          IsCheckedChanged="TextFilter_Changed"/>
				</Border>

				<Border Classes="callout" Margin="0,2">
					<Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="6">
						<TextBox x:Name="KeyFilterTextBox"
						         Grid.Column="0"
						         Classes="campaignField ignoreDirty"
						         Watermark="Key Filter"
						         TextChanged="TextFilter_Changed"/>
						<TextBox x:Name="OriginalFilterTextBox"
						         Grid.Column="1"
						         Classes="campaignField ignoreDirty"
						         Watermark="Original Text Filter"
						         TextChanged="TextFilter_Changed"/>
						<TextBox x:Name="TranslationFilterTextBox"
						         Grid.Column="2"
						         Classes="campaignField ignoreDirty"
						         Watermark="Translation Text Filter"
						         TextChanged="TextFilter_Changed"/>
						<ToggleButton x:Name="TextFilterModeToggle"
						              Grid.Column="3"
						              Theme="{StaticResource TranslationFilterToggleTheme}"
						              Classes="ignoreDirty"
						              MinWidth="64"
						              Padding="10,4"
						              Content="Show"
						              IsChecked="True"
						              Background="#55555A"
						              ToolTip.Tip="Show: keep rows matching any non-empty text filter. Hide: exclude those rows."
						              IsCheckedChanged="TextFilterModeToggle_IsCheckedChanged"/>
					</Grid>
				</Border>

				<Border Classes="callout" Margin="0,2">
					<Grid ColumnDefinitions="44,200,*,44,44">
						<TextBlock Grid.Column="0" Text="Done" Foreground="White" VerticalAlignment="Center"/>
						<TextBlock Grid.Column="1" Text="Key" Foreground="White" VerticalAlignment="Center"/>
						<TextBlock Grid.Column="2" Text="Translation" Foreground="White" VerticalAlignment="Center"/>
						<TextBlock Grid.Column="3" Text="Edit" Foreground="White" VerticalAlignment="Center"/>
						<TextBlock Grid.Column="4" Text="Del" Foreground="White" VerticalAlignment="Center"/>
					</Grid>
				</Border>

				<ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
					<ItemsControl x:Name="TranslationItemsControl">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Margin="0,2"
								        Classes="callout"
								        Background="{Binding ., Converter={StaticResource TransRowBg}}">
									<Grid ColumnDefinitions="44,200,*,44,44">
										<CheckBox Grid.Column="0"
										           IsChecked="{Binding translationOK, Mode=TwoWay}"
										           Margin="6,0"
										           VerticalAlignment="Center"/>
										<TextBlock Grid.Column="1"
										           Text="{Binding key}"
										           MaxHeight="48"
										           Foreground="White"
										           TextWrapping="Wrap"
										           VerticalAlignment="Center"/>
										<jimeui:PseudoHtmlPreviewTextBlock Grid.Column="2"
										                                   PseudoHtml="{Binding text}"
										                                   MaxHeight="40"
										                                   Foreground="White"
										                                   TextWrapping="Wrap"
										                                   VerticalAlignment="Center"
										                                   ClipToBounds="True"
										                                   Margin="6,0"/>
										<Button Grid.Column="3"
										        Background="CornflowerBlue"
										        Width="32"
										        Height="32"
										        Margin="4,0"
										        VerticalAlignment="Center"
										        Click="EditButton_Click"
										        DataContext="{Binding}">
											<Image Source="avares://JiMEditor.Avalonia/Assets/edit.png" Stretch="Uniform"/>
										</Button>
										<Button Grid.Column="4"
										        Background="{StaticResource bgCancelDelete}"
										        Width="32"
										        Height="32"
										        Margin="4,0"
										        VerticalAlignment="Center"
										        Click="DeleteButton_Click"
										        DataContext="{Binding}">
											<Image Source="avares://JiMEditor.Avalonia/Assets/remove.png" Stretch="Uniform"/>
										</Button>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</StackPanel>
		</ScrollViewer>

		<Border Grid.Row="1"
		        BorderThickness="0,1,0,0"
		        BorderBrush="Silver"
		        Background="#FF46464A">
			<WrapPanel HorizontalAlignment="Right">
				<Button Margin="10"
				        Background="MediumSeaGreen"
				        Click="OkButton_Click"
				        IsDefault="True">
					<Image Source="avares://JiMEditor.Avalonia/Assets/ok.png" Stretch="Uniform" Width="32" Margin="5"/>
				</Button>
				<Button x:Name="CancelButton"
				        Margin="0,10,10,10"
				        Background="{StaticResource bgCancelDelete}"
				        Click="CancelButton_Click"
				        IsCancel="True">
					<Image Source="avares://JiMEditor.Avalonia/Assets/cancel.png" Stretch="Uniform" Width="32" Margin="5"/>
				</Button>
			</WrapPanel>
		</Border>
	</Grid>
</Window>
