<!-- Ported from: JiMEditor/UserControls/SidebarListView.xaml (2026-04-05) -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JiMEditor.Avalonia.UserControls.SidebarListView"
             x:CompileBindings="False">

	<UserControl.Styles>
		<Style Selector="Button.sidebarIconButton">
			<Setter Property="Padding" Value="5"/>
			<Setter Property="MinWidth" Value="32"/>
			<Setter Property="MinHeight" Value="32"/>
			<Setter Property="CornerRadius" Value="2"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="Black"/>
		</Style>
		<Style Selector="Button.sidebarIconButton:pointerover">
			<Setter Property="BorderBrush" Value="White"/>
		</Style>
		<Style Selector="Button.sidebarIconButton:pressed">
			<Setter Property="Background" Value="#FF303030"/>
		</Style>
		<Style Selector="Button.sidebarIconButton:disabled">
			<Setter Property="Opacity" Value="0.25"/>
		</Style>
	</UserControl.Styles>

	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<StackPanel Spacing="0" HorizontalAlignment="Stretch">
			<TextBlock HorizontalAlignment="Center"
			           FontWeight="Bold"
			           Foreground="White"
			           Text="{Binding Title}"/>
			<!-- Min width = sidebar column (300) minus 40; stretch so the box uses full row width instead of sizing to the selected item. -->
			<ComboBox x:Name="dataListView"
			          Margin="3"
			          MinWidth="240"
			          MaxWidth="240"
			          HorizontalContentAlignment="Left"
			          SelectionChanged="DataListView_OnSelectionChanged">
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding dataName}" Foreground="White"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
			<StackPanel Orientation="Horizontal" Margin="5" Spacing="0">
				<Button x:Name="addInteraction"
				        Classes="sidebarIconButton"
				        Background="MediumSeaGreen"
				        Click="Add_Click">
					<Image Source="avares://JiMEditor.Avalonia/Assets/add.png" Width="24" Height="24"/>
				</Button>
				<Button x:Name="import"
				        Margin="5,0,0,0"
				        Classes="sidebarIconButton"
				        Background="#099145"
				        IsVisible="{Binding ShowImportButton}"
				        Click="Import_Click">
					<Image Source="avares://JiMEditor.Avalonia/Assets/import.png" Width="32" Height="32" Margin="-5"/>
				</Button>
				<Button x:Name="removeInteraction"
				        Margin="5,0,0,0"
				        Classes="sidebarIconButton"
				        Background="#ff4200"
				        Click="Remove_Click">
					<Image Source="avares://JiMEditor.Avalonia/Assets/remove.png" Width="24" Height="24"/>
				</Button>
				<Button x:Name="duplicate"
				        Margin="5,0,0,0"
				        Classes="sidebarIconButton"
				        Background="MediumSeaGreen"
				        IsVisible="{Binding ShowDuplicateButton}"
				        Click="Duplicate_Click">
					<Image Source="avares://JiMEditor.Avalonia/Assets/duplicate.png" Width="24" Height="24"/>
				</Button>
				<Button x:Name="export"
				        Margin="5,0,0,0"
				        Classes="sidebarIconButton"
				        Background="#1d75be"
				        IsVisible="{Binding ShowExportButton}"
				        Click="Export_Click">
					<Image Source="avares://JiMEditor.Avalonia/Assets/export.png" Width="32" Height="32" Margin="-5"/>
				</Button>
				<Button x:Name="settings"
				        Margin="5,0,0,0"
				        Classes="sidebarIconButton"
				        Background="Silver"
				        Click="Settings_Click">
					<Image Source="avares://JiMEditor.Avalonia/Assets/edit.png" Width="24" Height="24"/>
				</Button>
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
