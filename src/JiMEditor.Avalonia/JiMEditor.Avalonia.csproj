<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Same One Ring artwork as WPF JiMEditor; embeds in .exe and Avalonia default window icon. -->
    <ApplicationIcon>ring.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <!-- Windows-only app host metadata; ignored on non-Windows RIDs. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />
    <PackageReference Include="FlowGraph.Avalonia" Version="0.8.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.11">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SpacedGrid-Avalonia" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\*.json" />
  </ItemGroup>

  <!-- JiME engine JSON (embedded resources read via Assembly.GetManifestResourceStream). -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\tiles.json" />
    <EmbeddedResource Include="Assets\hextilesA.json" />
    <EmbeddedResource Include="Assets\hextilesB.json" />
    <EmbeddedResource Include="Assets\enemy-defaults.json" />
    <EmbeddedResource Include="Assets\enemy-activation-defaults.json" />
    <EmbeddedResource Include="Assets\enemy-activation-defaults-original.json" />
    <EmbeddedResource Include="Assets\terrain-interactions.json" />
    <EmbeddedResource Include="Procedural\Assets\story-archetypes.json" />
    <EmbeddedResource Include="Procedural\Assets\story-templates.json" />
    <EmbeddedResource Include="Procedural\Assets\story-locations.json" />
    <EmbeddedResource Include="Procedural\Assets\story-fragments.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- GraphX-era visualization models kept for reference; Avalonia graph lives under ScenarioGraph/. -->
    <Compile Remove="JiME\Models\Visualization\**\*.cs" />
  </ItemGroup>
</Project>
