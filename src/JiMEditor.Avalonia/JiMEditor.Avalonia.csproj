<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWpf>true</UseWpf>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.7" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.7" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.7" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.7">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- When JiMEditor is a sibling repo, tile PNGs are linked here as avares://…/Assets/TilesA|B/… (avoid duplicating the same paths under local Assets/Tiles*). -->
    <AvaloniaResource Include="..\..\..\JiMEditor\Assets\TilesA\**\*.png" Link="Assets\TilesA\%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\..\..\JiMEditor\Assets\TilesB\**\*.png" Link="Assets\TilesB\%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\..\..\JiMEditor\Assets\Tokens\*.png" Link="Assets\Tokens\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\..\..\JiMEditor\Assets\Terrain\*.png" Link="Assets\Terrain\%(Filename)%(Extension)" />
    <!-- Campaign window toolbar icons (JiMEditor/Assets) -->
    <AvaloniaResource Include="..\..\..\JiMEditor\Assets\add2.png" Link="Assets\add2.png" />
    <AvaloniaResource Include="..\..\..\JiMEditor\Assets\addpage.png" Link="Assets\addpage.png" />
    <AvaloniaResource Include="..\..\..\JiMEditor\Assets\dice.png" Link="Assets\dice.png" />
    <AvaloniaResource Include="..\..\..\JiMEditor\Assets\arrow.png" Link="Assets\arrow.png" />
    <AvaloniaResource Include="..\..\..\JiMEditor\Assets\edit.png" Link="Assets\edit.png" />
    <AvaloniaResource Include="..\..\..\JiMEditor\Assets\package.png" Link="Assets\package.png" />
    <AvaloniaResource Include="..\..\..\JiMEditor\Assets\help.png" Link="Assets\help.png" />
    <AvaloniaResource Include="..\..\..\JiMEditor\Assets\ok.png" Link="Assets\ok.png" />
    <AvaloniaResource Include="..\..\..\JiMEditor\Assets\save.png" Link="Assets\save.png" />
    <AvaloniaResource Include="..\..\..\JiMEditor\Assets\cancel.png" Link="Assets\cancel.png" />
    <!-- MainWindow sidebar (JiMEditor/Assets) -->
    <AvaloniaResource Include="..\..\..\JiMEditor\Assets\add.png" Link="Assets\add.png" />
    <AvaloniaResource Include="..\..\..\JiMEditor\Assets\remove.png" Link="Assets\remove.png" />
    <AvaloniaResource Include="..\..\..\JiMEditor\Assets\duplicate.png" Link="Assets\duplicate.png" />
    <AvaloniaResource Include="..\..\..\JiMEditor\Assets\import.png" Link="Assets\import.png" />
    <AvaloniaResource Include="..\..\..\JiMEditor\Assets\export.png" Link="Assets\export.png" />
    <AvaloniaResource Include="..\..\..\JiMEditor\Assets\LoTR-JiME-Icons.ttf" Link="Assets\LoTR-JiME-Icons.ttf" />
  </ItemGroup>

  <!-- JiME engine JSON etc. (embedded resources read via Assembly.GetManifestResourceStream) -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\JiMEditor\Assets\tiles.json" Link="Assets\tiles.json" />
    <EmbeddedResource Include="..\..\..\JiMEditor\Assets\hextilesA.json" Link="Assets\hextilesA.json" />
    <EmbeddedResource Include="..\..\..\JiMEditor\Assets\hextilesB.json" Link="Assets\hextilesB.json" />
    <EmbeddedResource Include="..\..\..\JiMEditor\Assets\enemy-defaults.json" Link="Assets\enemy-defaults.json" />
    <EmbeddedResource Include="..\..\..\JiMEditor\Assets\enemy-activation-defaults.json" Link="Assets\enemy-activation-defaults.json" />
    <EmbeddedResource Include="..\..\..\JiMEditor\Assets\enemy-activation-defaults-original.json" Link="Assets\enemy-activation-defaults-original.json" />
    <EmbeddedResource Include="..\..\..\JiMEditor\Assets\terrain-interactions.json" Link="Assets\terrain-interactions.json" />
    <EmbeddedResource Include="..\..\..\JiMEditor\Procedural\Assets\story-archetypes.json" Link="Procedural\Assets\story-archetypes.json" />
    <EmbeddedResource Include="..\..\..\JiMEditor\Procedural\Assets\story-templates.json" Link="Procedural\Assets\story-templates.json" />
    <EmbeddedResource Include="..\..\..\JiMEditor\Procedural\Assets\story-locations.json" Link="Procedural\Assets\story-locations.json" />
    <EmbeddedResource Include="..\..\..\JiMEditor\Procedural\Assets\story-fragments.json" Link="Procedural\Assets\story-fragments.json" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="JiME\Models\Visualization\**\*.cs" />
  </ItemGroup>
</Project>
