<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- Ported from: JiMEditor/App.xaml — text / ScrollBar styles for ProjectWindow (2026-04-04) -->
	<Style Selector="TextBlock.buttonHeading">
		<Setter Property="FontSize" Value="16"/>
		<Setter Property="Foreground" Value="White"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<Style Selector="TextBlock.heading">
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="Foreground" Value="White"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<Style Selector="TextBlock.subText">
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="Foreground" Value="Silver"/>
	</Style>

	<Style Selector="ScrollBar">
		<Setter Property="Background" Value="#333337"/>
	</Style>

	<!-- MainWindow toolbar icon buttons (WPF iconbutton) -->
	<Style Selector="Button.iconbutton">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
	</Style>
	<Style Selector="Button.iconbutton:pointerover">
		<Setter Property="Background" Value="#3a3a3e"/>
	</Style>

	<!-- MainWindow chapter cards (WPF callout) -->
	<Style Selector="Border.callout">
		<Setter Property="Padding" Value="10"/>
		<Setter Property="CornerRadius" Value="5"/>
		<Setter Property="Background" Value="{StaticResource bgColorLight}"/>
	</Style>

	<!-- MainWindow Tile Blocks list: white outline on rounded callout cards -->
	<Style Selector="Border.callout.tileBlockCard">
		<Setter Property="BorderBrush" Value="White"/>
		<Setter Property="BorderThickness" Value="1"/>
	</Style>

	<Style Selector="Border.callout.tileBlockCard.tileBlockDropTarget">
		<Setter Property="BorderBrush" Value="#FFE8E8E8"/>
		<Setter Property="BorderThickness" Value="2"/>
	</Style>

	<Style Selector="Border.callout.tileBlockCard.tileBlockDragging">
		<Setter Property="Opacity" Value="0.55"/>
	</Style>

	<Style Selector="Border.callout.tileBlockCard.tileBlockDragGhost">
		<Setter Property="Opacity" Value="0.92"/>
		<Setter Property="BoxShadow" Value="0 6 16 0 #88000000"/>
	</Style>

	<!--
		FluentTheme's default TabControl looks Win11 / Mica-like; JiMEditor WPF used flat VS-style tabs.
		Apply Classes="jimeTabStrip" on TabControl to get closer to the reference (dark chrome, selected tab = content bg).
	-->
	<Style Selector="TabControl.jimeTabStrip">
		<Setter Property="Background" Value="#FF2D2D30"/>
	</Style>
	<Style Selector="TabControl.jimeTabStrip TabItem">
		<Setter Property="Padding" Value="10,8"/>
		<Setter Property="Foreground" Value="#E8E8E8"/>
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="Background" Value="#323236"/>
		<Setter Property="BorderBrush" Value="#555555"/>
		<Setter Property="BorderThickness" Value="1,1,1,0"/>
		<Setter Property="CornerRadius" Value="4,4,0,0"/>
		<Setter Property="Margin" Value="0,4,2,0"/>
	</Style>
	<Style Selector="TabControl.jimeTabStrip TabItem:pointerover">
		<Setter Property="Background" Value="#3E3E42"/>
	</Style>
	<Style Selector="TabControl.jimeTabStrip TabItem:selected">
		<Setter Property="Background" Value="#FF2D2D30"/>
		<Setter Property="Foreground" Value="White"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="BorderBrush" Value="#777777"/>
	</Style>
	<Style Selector="TabControl.jimeTabStrip TabItem:selected:pointerover">
		<Setter Property="Background" Value="#FF2D2D30"/>
	</Style>
</Styles>
